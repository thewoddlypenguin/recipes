cat > .gitignore <<'EOF'
# Local Workshop metadata
.workshop/

# Environment files
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node
node_modules/
dist/
build/
.vite/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Database/data/runtime
*.sqlite
*.db
postgres_data/
backups/
*.sql
*.tar.gz

# Uploads/media - keep folder structure, not actual uploaded media
uploads/*
!uploads/.gitkeep
!uploads/recipes/
uploads/recipes/*
!uploads/recipes/.gitkeep
!uploads/wordpress-import/
uploads/wordpress-import/*
!uploads/wordpress-import/.gitkeep

# OS/editor
.DS_Store
Thumbs.db
.idea/
.vscode/
EOF
