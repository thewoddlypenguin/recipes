# ---------- Database ----------
POSTGRES_DB=mikkelsen_recipes
POSTGRES_USER=mikkelsen
POSTGRES_PASSWORD=change-me
# Inside docker compose, the host is "db". For local (non-docker) dev use localhost.
DATABASE_URL=postgresql+psycopg://mikkelsen:change-me@db:5432/mikkelsen_recipes

# ---------- Backend ----------
SECRET_KEY=change-me-generate-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

UPLOAD_DIR=/app/uploads
PUBLIC_UPLOAD_URL=/uploads

INITIAL_ADMIN_EMAIL=justin@example.com
INITIAL_ADMIN_PASSWORD=change-me

# Compose startup behavior
RUN_MIGRATIONS=true
AUTO_SEED=true

# CORS (comma-separated origins allowed to call the API)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ---------- Frontend (build-time) ----------
VITE_API_BASE_URL=
# Nav link label/URL for the personal site button in the header
VITE_JUSTINSPACE_URL=https://justinmikkelsen.com

# ---------- Notes ----------
# - Never commit a real .env. Copy this file to .env and edit values.
# - If VITE_API_BASE_URL is empty the frontend calls same-origin /api
#   (dev proxy or nginx proxy), which is the recommended setup.